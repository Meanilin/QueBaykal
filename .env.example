# --- Application ---
ENVIRONMENT=dev
SERVICE_NAME=cinema-queue-bot
DEBUG=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON_OUTPUT=false
LOG_INCLUDE_TIMESTAMP=true

# --- Telegram ---
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_ADMIN_IDS=123456789,987654321
TG_PARSE_MODE=HTML
TG_BOT_MODE=polling
# TG_WEBHOOK_DOMAIN=bot.example.com
# TG_WEBHOOK_PATH=/webhook
# TG_WEBHOOK_SECRET=change_me

# --- Database (PostgreSQL via asyncpg) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cinema
POSTGRES_PASSWORD=cinema_secret
POSTGRES_DB=cinema_queue
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=30

# --- Redis (FSM + cache) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
REDIS_FSM_TTL_SECONDS=86400
REDIS_CACHE_TTL_SECONDS=300

# --- HTTP API ---
API_HOST=0.0.0.0
API_PORT=8080
API_CORS_ORIGINS=*
# API_AGENTS_API_KEY=change_me
